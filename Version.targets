<Project>
 <PropertyGroup>
    <NightlyTag>nightly</NightlyTag>
    <RegexPre>pre\d</RegexPre>
 </PropertyGroup>

 <!--
   Everything version-related below that used to be keyed off $(CI) is keyed off this instead.

   $(CI) is the WRONG signal for it. GitHub Actions - which is this fork's only CI, see
   .github/workflows/linux-gtk.yml - always exports CI=true, and Environment.Build.props then
   leaves it at true because its default only applies when CI is empty. But every branch guarded
   by it here is Azure DevOps specific: BUILDVERSION, BUILD_REASON, BUILD_BUILDID,
   SYSTEM_PULLREQUEST_* and the ##vso[...] logging commands all exist only on Azure. Off Azure
   those variables are empty, so the PackageVersion override produced a dangling fourth component
   and NuGet rejected it outright:

     error MSB4018: System.ArgumentException:
       PackageVersion string specified '5.0.0.+1048-sha.<commit>-azdo.' is invalid.

   Because every shipping csproj sets GeneratePackageOnBuild, that killed the plain
   `dotnet build Xamarin.Forms.Gtk.sln` step in the workflow - CI could not build itself.

   TF_BUILD is Azure's own "I am a build agent" variable and is the correct gate. On GitHub
   Actions this is false and the normal PackageVersion on line 38 applies.
 -->
 <PropertyGroup>
    <IsAzurePipelines Condition="'$(IsAzurePipelines)' == ''">false</IsAzurePipelines>
    <IsAzurePipelines Condition="'$(TF_BUILD)' == 'true'">true</IsAzurePipelines>
 </PropertyGroup>
 <PropertyGroup>
    <GitBranch Condition="'$(SYSTEM_PULLREQUEST_TARGETBRANCH)' != ''">$(SYSTEM_PULLREQUEST_TARGETBRANCH)</GitBranch>
    <GitBranch Condition="'$(SYSTEM_PULLREQUEST_TARGETBRANCH)' == '' and '$(BUILD_SOURCEBRANCHNAME)' != ''">$(BUILD_SOURCEBRANCHNAME)</GitBranch>
  </PropertyGroup>

  <Target Name="SetVersions"
          BeforeTargets="PrepareForBuild;GetAssemblyVersion;GetPackageVersion;Pack"
          DependsOnTargets="GitVersion"
          Returns="$(Version)"
         >
    <PropertyGroup>
      <PreOut>$([System.Text.RegularExpressions.Regex]::Match($(GitTag), $(RegexPre)))</PreOut>
      <GitSemVerLabel Condition=" '$(GitTag)' != '' and '$(GitTag)' == '$(GitBranch)' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(GitTag)', $(RegexPre))) ">$(PreOut)</GitSemVerLabel>
      <GitSemVerLabel  Condition="$(IsAzurePipelines) and '$(BUILD_REASON)' == 'Schedule'">$(NightlyTag)</GitSemVerLabel>
      <GitSemVerDashLabel Condition="'$(GitSemVerLabel)' != ''" >-$(GitSemVerLabel)</GitSemVerDashLabel>
    </PropertyGroup>
    <ItemGroup>
      <VersionMetadata Include="$(GitCommits)" Condition="'$(GitSemVerDashLabel)' == ''" />

      <VersionMetadata Condition="$(IsAzurePipelines) and '$(BUILD_REASON)' == 'PullRequest'"
                       Include="pr.$(SYSTEM_PULLREQUEST_PULLREQUESTNUMBER)"/>

      <VersionMetadata Include="sha.$(GitCommit)"/>

      <VersionMetadata Condition="$(IsAzurePipelines)"
                       Include="azdo.$(BUILD_BUILDID)"/>
    </ItemGroup>

    <PropertyGroup>
      <VersionMetadataLabel>@(VersionMetadata -> '%(Identity)', '-')</VersionMetadataLabel>
      <VersionMetadataPlusLabel Condition="'$(VersionMetadataLabel)' != ''">+$(VersionMetadataLabel)</VersionMetadataPlusLabel>
      <Version>$(GitBaseVersionMajor).$(GitBaseVersionMinor).$(GitBaseVersionPatch)</Version>
      <!--
        Four components, $(VersionPrefix).$(VersionSuffix), not the three GitSemVer* supplies.

        The other six packable projects import Net4x.NuGetUtility, whose PrepareGenerateNuspecPack
        runs BeforeTargets="GenerateNuspec" - i.e. after this target - and overwrote PackageVersion
        with exactly $(VersionPrefix).$(VersionSuffix). The result was that the same commit packed
        three different ways: six packages as 5.0.0.<yyddd> on Windows, Xamarin.Forms.Platform.GTK
        (which deliberately does not import that tooling) as 5.0.0, and on Linux - where the
        tooling is skipped by its own '$(OS)' == 'Windows_NT' condition - all seven as 5.0.0.
        Computing the same value here makes that overwrite a no-op rather than the thing that
        decides the version, so every project agrees and both OSes produce the same file names.

        The commit still survives the change. NuGet strips +build-metadata from package identity
        and from the .nupkg file name, so the file is Net4x.<id>.5.0.0.<yyddd>.nupkg while the
        InformationalVersion set below - and the AssemblyMetadata("PackageVersion") attribute -
        still name the sha. Do not fold the sha into the version proper to "fix" the file name:
        a four-part version plus a dash-label is where NuGet stops treating it as stable.
      -->
      <PackageVersion>$(VersionPrefix).$(VersionSuffix)$(GitSemVerDashLabel)$(VersionMetadataPlusLabel)</PackageVersion>

      <PackageVersion Condition="$(IsAzurePipelines)">$(GitSemVerMajor).$(GitSemVerMinor).$(GitBaseVersionPatch).$(BUILDVERSION)$(GitSemVerDashLabel)$(VersionMetadataPlusLabel)</PackageVersion>
      <PackageVersion Condition="$(IsAzurePipelines) and '$(GitBaseVersion)' == '4.2.0'">$(GitSemVerMajor).$(GitSemVerMinor).$(GitBaseVersionPatch).$(BUILDVERSION42)$(GitSemVerDashLabel)$(VersionMetadataPlusLabel)</PackageVersion>
      <PackageVersion Condition="$(IsAzurePipelines) and '$(GitBaseVersion)' == '4.3.0'">$(GitSemVerMajor).$(GitSemVerMinor).$(GitBaseVersionPatch).$(BUILDVERSION43)$(GitSemVerDashLabel)$(VersionMetadataPlusLabel)</PackageVersion>
      <PackageVersion Condition="$(IsAzurePipelines) and '$(GitBaseVersion)' == '4.4.0'">$(GitSemVerMajor).$(GitSemVerMinor).$(GitBaseVersionPatch).$(BUILDVERSION44)$(GitSemVerDashLabel)$(VersionMetadataPlusLabel)</PackageVersion>
    </PropertyGroup>

    <PropertyGroup>
      <InformationalVersion>$(PackageVersion)</InformationalVersion>
      <FileVersion>$(Version).$(GitCommits)</FileVersion>
      <AssemblyVersion>2.0.0.0</AssemblyVersion> <!-- THIS SHALL REMAIN 2.0.0.0 -->
    </PropertyGroup>

    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
        <_Parameter1>Version</_Parameter1>
        <_Parameter2>2.0.0.0</_Parameter2> <!-- THIS SHALL REMAIN 2.0.0.0 -->
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
        <_Parameter1>PackageVersion</_Parameter1>
        <_Parameter2>$(PackageVersion)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>

    <Message Condition="$(IsAzurePipelines) and '$(BUILD_REASON)' == 'Schedule'" Importance="high" Text="##vso[build.addbuildtag]$(NightlyTag)"/>
    <ItemGroup>
       <XamarinFormsVersionFile Include="../.XamarinFormsVersionFile.txt"/>
       <XamarinFormsVersionLine Include="$(PackageVersion)"/>
    </ItemGroup>
    
    <!-- Occasionally this throws an error from parallel builds writing to this file. It's fine if only one of them wins. -->
    <WriteLinesToFile ContinueOnError="WarnAndContinue" File="@(XamarinFormsVersionFile)" Lines="@(XamarinFormsVersionLine)" Overwrite="true" />
    <Message Condition="$(IsAzurePipelines)" Importance="high" Text="##vso[build.updatebuildnumber]$(PackageVersion)"/>
    <Message Condition="$(IsAzurePipelines)" Importance="high" Text="##vso[task.setvariable variable=XamarinFormsPackageVersion;isOutput=true;]$(PackageVersion)"/>
  </Target>

  <Target Name="VersionInfoReport" DependsOnTargets="SetVersions" AfterTargets="GitInfoReport">
   <ItemGroup>
		<Message Importance="$(GitInfoReportImportance)" Text="Version Info:
  AssemblyVersion:        $(AssemblyVersion)
  FileVersion:            $(FileVersion)
  InformationalVersion:   $(InformationalVersion)
  PackageVersion:         $(PackageVersion)
  Version:        $(Version)
  VersionPrefix:  $(VersionPrefix)
  VersionSuffix:  $(VersionSuffix)
"/>
   </ItemGroup>
	</Target>

</Project>