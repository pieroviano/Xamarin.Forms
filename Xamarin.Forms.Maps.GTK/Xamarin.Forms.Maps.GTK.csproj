<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.props" Condition="'$(OS)' == 'Windows_NT' AND Exists('$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.props')" />
    <PropertyGroup>
        <PackageOutputPath>$(XFPackageOutputPath)</PackageOutputPath>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <Version>$(VersionPrefix).$(VersionSuffix)</Version>
        <PackageId>Net4x.Xamarin.Forms.Maps.GTK</PackageId>
        <Description>GTK4 map renderer for Xamarin.Forms.Maps, drawn with Cairo over OpenStreetMap-compatible tiles.</Description>
        <IsPackable>true</IsPackable>
        <TargetFramework>netstandard2.0</TargetFramework>
        <AssemblyName>Xamarin.Forms.Maps.GTK</AssemblyName>
        <RootNamespace>Xamarin.Forms.Maps.GTK</RootNamespace>
        <LangVersion>latest</LangVersion>
        <!--
          TRUE, so the SDK emits AssemblyVersion/FileVersion/InformationalVersion from the
          values Version.targets computes. With it off, and a hand-written AssemblyInfo.cs
          that carries only ExportRenderer/Dependency attributes, these two shipping
          assemblies compiled with AssemblyVersion 0.0.0.0 while Core and Xaml carried the
          intended 2.0.0.0 - so binding redirects and any strong-name identity check saw a
          version the rest of the framework never uses.
        -->
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
        <!--
      CS0612 ("X is obsolete") is not an error in these two projects, and this is a deliberate,
      bounded deferral rather than a blanket silence. Gtk 4.10-4.12 deprecated a family of APIs that
      it still ships and still supports; each replacement is a separate piece of work, not a rename:

        Gtk.MessageDialog            -> Gtk.AlertDialog (4.10). A different, async-only API; the
                                        dialog helper here would be rewritten, not adjusted.
        Gtk.Widget.StyleContext,     -> StyleContext.AddProviderForDisplay for providers and
        Gtk.StyleContext                Widget.StyleColor for colours. Extensions/StyleExtensions
                                        attaches providers PER WIDGET, which is the part with no
                                        display-wide equivalent.
        ListStore, TreeIter,         -> Gtk.ListView / ColumnView over a GListModel (4.10). This is
        CellRendererText, CellView,     the whole cell-renderer world, and replacing it means
        ComboBox                        rewriting Controls/ListView, Controls/TableView and Cells/*.
                                        Tracked as follow-up in docs/plans/gtk4-migration.md.
        Gtk.Image(Gdk.Pixbuf)        -> Image.NewFromPaintable (4.12).
        Gdk.CairoHelper.SetSourcePixbuf -> GdkPaintable/GdkTexture. Maps.GTK composes its map tile by
                                        tile onto one Cairo surface, so this is a compositor
                                        rewrite rather than a call swap.

      Scoped to these projects on purpose: NOT in Directory.Build.props, where it would also cover
      Core, Xaml and Build.Tasks, and would hide the next deprecation in code that has nothing to do
      with Gtk. Everything Gtk 4 actually REMOVED is a hard error and was ported; this list is only
      what it deprecated.
    -->
        <NoWarn>$(NoWarn);CS0612</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Net4x.NuGetUtility" Version="$(NuGetUtilityVersion)" PrivateAssets="All" Condition="'$(OS)' == 'Windows_NT'" />
        <!--
          Pinned explicitly, to the same version as Xamarin.Forms.Platform.GTK. See the comment
          there: the Net4x.NuGetUtility tooling has property-ised this reference before and broken
          restore with "'.' is not a valid version string". Do not let it be property-ised again -
          it has already happened twice. $(InputBoxLibraryVersion) and $(VersionBuildSuffix) are
          unrelated and undefined here, so the version evaluated to the bare string ".".

          Net4x.GtkSharp, NOT GtkSharp, since the Gtk 4 migration - and the same tooling rewrites
          the Include back to the bare "GtkSharp", which would restore the GTK 3 package next to
          this one. _XFAssertNoGtk3Package below fails the build if that happens.
        -->
        <PackageReference Include="Net4x.GtkSharp" Version="$(GtkSharpVersion).$(GtkSharpVersionBuildSuffix)" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Xamarin.Forms.Core\Xamarin.Forms.Core.csproj" />
        <ProjectReference Include="..\Xamarin.Forms.Maps\Xamarin.Forms.Maps.csproj" />
        <ProjectReference Include="..\Xamarin.Forms.Platform.GTK\Xamarin.Forms.Platform.GTK.csproj" />
    </ItemGroup>
    <PropertyGroup>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <Content Include="README.md" Link="README.md" Pack="true" PackagePath="\README.md" />
        <Content Include="$(SolutionDir)License.txt" Link="License.txt" Pack="true" PackagePath="\License.txt" Condition="Exists('$(SolutionDir)License.txt')" />
    </ItemGroup>
    <Import Project="$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.targets" Condition="'$(OS)' == 'Windows_NT' AND Exists('$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.targets')" />
    <!--
      See the identically named target in Xamarin.Forms.Platform.GTK.csproj for why this exists.
      Short version: the tooling imported just above rewrites the Include of this project's
      bindings reference to the bare string "GtkSharp", which is the GTK 3 package - a second
      assembly defining namespace Gtk, and errors that point anywhere but here.
    -->
    <Target Name="_XFAssertNoGtk3Package" BeforeTargets="BeforeBuild;Pack">
        <Error Condition="'@(PackageReference-&gt;AnyHaveMetadataValue('Identity', 'GtkSharp'))' == 'true'" Text="A PackageReference to 'GtkSharp' (the GTK 3 bindings) is present in $(MSBuildProjectFile) alongside Net4x.GtkSharp. This backend targets GTK 4; the two packages both define namespace Gtk and cannot coexist. Remove it again - see the comment in Directory.Build.props." />
    </Target>
</Project>