<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.props" Condition="'$(OS)' == 'Windows_NT' AND Exists('$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.props')" />
    <PropertyGroup>
        <PackageOutputPath>$(SolutionDir)Packages/</PackageOutputPath>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <Version>$(VersionPrefix).$(VersionSuffix)</Version>
        <IsPackable>false</IsPackable>
        <TargetFramework>netstandard2.0</TargetFramework>
        <XFDisableTargetsValidation>True</XFDisableTargetsValidation>
        <PackageId>Net4x.$(AssemblyName)</PackageId>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <DefineConstants>TRACE;DEBUG;PERF;APP</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
        <NoWarn>0114;0108;0109;4014;0649;0169;0472;0414;0168;0219;0429</NoWarn>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <DefineConstants>TRACE;APP</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
        <NoWarn>0114;0108;0109;4014;0649;0169;0472;0414;0168;0219;0429</NoWarn>
    </PropertyGroup>
    <PropertyGroup Condition="$(TargetFramework.StartsWith('uap10.0'))">
        <DefineConstants>$(DefineConstants);__UWP__</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="BuildNumber.txt" />
        <None Remove="Fonts\CuteFont-Regular.ttf" />
        <None Remove="Fonts\Dokdo-Regular.ttf" />
        <None Remove="Fonts\fa-regular-400.ttf" />
        <None Remove="Fonts\PTM55FT.ttf" />
    </ItemGroup>
    <ItemGroup>
        <!-- A reference to the entire .NET Framework is automatically included -->
        <ProjectReference Include="..\Xamarin.Forms.Core\Xamarin.Forms.Core.csproj" Condition="$(FromSource) == 'true'" />
        <ProjectReference Include="..\Xamarin.Forms.CustomAttributes\Xamarin.Forms.CustomAttributes.csproj" Condition="$(FromSource) == 'true'" />
        <ProjectReference Include="..\Xamarin.Forms.Maps\Xamarin.Forms.Maps.csproj" Condition="$(FromSource) == 'true'" />
        <ProjectReference Include="..\Xamarin.Forms.Xaml\Xamarin.Forms.Xaml.csproj" Condition="$(FromSource) == 'true'" />
        <!--
      Build-order only (ReferenceOutputAssembly=false): this project's XAML is compiled by
      XamlGTask/XamlCTask, which are now loaded from Build.Tasks' own output, so Build.Tasks
      must be built first. There is otherwise no dependency edge between them, and a
      solution build is free to compile this project first. The old .nuspec copy masked
      that by leaving task DLLs behind from a previous build.
    -->
        <ProjectReference Include="..\Xamarin.Forms.Build.Tasks\Xamarin.Forms.Build.Tasks.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" Condition="$(FromSource) == 'true'" />
        <ProjectReference Include="..\Xamarin.Forms.CustomAttributes\Xamarin.Forms.CustomAttributes.csproj" Condition="$(FromSource) == 'false'" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="System.Threading.Thread" Version="4.3.0" />
        <!--
        NOT the "xunit.v3" metapackage: it ships only net472 and net8.0 assets, so it does
        not restore against this project's netstandard2.0 target (NU1202). These three are
        the v3 packages that do carry a netstandard2.0 leg, which is what lets the engine
        load inside the MonoAndroid / Xamarin.iOS / uap10.0 gallery apps:

          xunit.v3.extensibility.core   [Fact]/[Theory] plus XunitTestFramework, the
                                        discoverer and the executor. v3 drops v2's
                                        IAssemblyInfo reflection abstraction and takes a
                                        loaded Assembly directly - exactly what an
                                        on-device run needs, since there is no file path
                                        to hand a console runner inside an APK or .app.
          xunit.v3.assert               Assert.
          xunit.v3.runner.common        Xunit.Runner.Common.TestFrameworkOptions, the only
                                        public ITestFrameworkDiscoveryOptions/
                                        ExecutionOptions implementation. v3 added ToJson()
                                        to ITestFrameworkOptions, so hand-rolling one is no
                                        longer just a typed dictionary.

        xunit.runner.visualstudio is deliberately absent: it is a VSTest adapter, and
        nothing discovers tests in a gallery app through VSTest. Its version was also
        $(Net4xXUnit2Version).$(VersionBuildSuffix), which resolves to a non-existent
        "1.0.0.*" - do not reintroduce a property-ised version for a third-party package.
      -->
        <PackageReference Include="xunit.v3.extensibility.core" Version="3.2.2" />
        <PackageReference Include="xunit.v3.assert" Version="3.2.2" />
        <PackageReference Include="xunit.v3.runner.common" Version="3.2.2" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
        <PackageReference Include="Xam.Plugin.DeviceInfo" Version="3.0.2" />
    </ItemGroup>
    <ItemGroup>
