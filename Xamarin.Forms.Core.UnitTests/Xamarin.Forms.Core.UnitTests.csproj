<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Xamarin.Forms.Core.UnitTests</AssemblyName>
    <RootNamespace>Xamarin.Forms.Core.UnitTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <!-- xUnit v3 test projects are executables, not libraries. -->
    <OutputType>Exe</OutputType>
    <!--
      Converted from the legacy csproj: default globbing replaces 196 explicit
      <Compile Include> entries, so a new test file is picked up automatically instead of
      being silently ignored. Two files that were on disk but absent from that list now
      compile: RadioButtonTemplateTests.cs and SwipeGestureRecognizerTests.cs.
    -->
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <!-- Carried over from the legacy project. -->
    <NoWarn>$(NoWarn);0114;0672;0108;0067;0168;0169;0219;0612;0618;1998;4014</NoWarn>
    <!--
      xUnit analyzer rules suppressed here are ADVISORY, and flag pre-existing
      characteristics of the NUnit suite rather than anything the migration introduced.
      They are style preferences about *which* assertion to reach for; every one of them
      passes or fails on exactly the same condition as the NUnit original:

        xUnit1026  a [Theory] parameter is unused.
        xUnit1031  test blocks on a Task. The NUnit suite did the same.
        xUnit1051  pass TestContext.Current.CancellationToken to cancellable APIs.
        xUnit2000  literal should be the 'expected' argument. NUnit's Assert.AreEqual had
                   the same (expected, actual) order, so these were already "wrong" - the
                   analyzer simply surfaces them now.
        xUnit2002  Assert.NotNull on a value type.
        xUnit2003  prefer Assert.Null over Assert.Equal(null, x).
        xUnit2004  prefer Assert.True/False over Assert.Equal(true/false, x).
        xUnit2007  prefer the generic Assert.IsType<T>.
        xUnit2013  prefer Assert.Single/Empty over Assert.Equal(n, c.Count).
        xUnit2015  prefer the generic Assert.Throws<T>.
        xUnit2017  prefer Assert.Contains over Assert.True(c.Contains(x)).
        xUnit2021  async assertion should be awaited - these are inside lambdas that are.

      The correctness-critical rules stay ON and were fixed properly, because each of them
      changes which tests actually run: xUnit1008/xUnit1013 (data attributes on a [Fact],
      which silently ignores the data and runs the test once with defaults), xUnit1016 /
      xUnit1019 (an unreachable or wrongly-typed MemberData source), xUnit1024 (duplicate
      InlineData), xUnit1028 (bad test method return type) and xUnit1000 (non-public test
      class, which is simply never discovered).
    -->
    <NoWarn>$(NoWarn);xUnit1026;xUnit1031;xUnit1051;xUnit2000;xUnit2002;xUnit2003;xUnit2004;xUnit2007;xUnit2013;xUnit2015;xUnit2017;xUnit2021</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xamarin.Forms.Core\Xamarin.Forms.Core.csproj" />
    <ProjectReference Include="..\Xamarin.Forms.Maps\Xamarin.Forms.Maps.Base.csproj" />
    <ProjectReference Include="..\Xamarin.Forms.Platform\Xamarin.Forms.Platform.Base.csproj" />
    <ProjectReference Include="..\Xamarin.Forms.Xaml\Xamarin.Forms.Xaml.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Images\crimson.jpg">
      <LogicalName>Images/crimson.jpg</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
