<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Repo-scoped feed list. <clear /> is deliberate: without it NuGet inherits
    parent-directory configs, and a Windows-only local source (e.g. D:\...\Packages)
    breaks restore when the same tree is built from WSL/Linux.
    dotnet-eng is required by the upstream build, see README.md "Getting Started".
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="dotnet-eng" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-eng/nuget/v3/index.json" protocolVersion="3" />
    <add key="Local" value="D:\Starb\Packages" />
  </packageSources>
</configuration>
