<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Sample/support project: not shipped as a package. -->
    <IsPackable>false</IsPackable>

    <ProjectGuid>{03A51E5B-0A1E-41F0-AAE3-4B19406F7340}</ProjectGuid>
    <!-- Exe, not WinExe: WinExe is a Windows-subsystem concept and there is no such
         distinction on Linux; it also suppresses the console output we rely on. -->
    <OutputType>Exe</OutputType>
    <!--
      net10.0, NOT netstandard2.0. Verified empirically: with netstandard2.0 this project
      still compiles to a .dll, but no runtimeconfig.json is emitted (netstandard names no
      runtime), so the host treats it as self-contained and fails at launch with
      "The library 'libhostpolicy.so' required to execute the application was not found".
      Libraries target netstandard; an application must name a concrete runtime.
      Xamarin.Forms.Platform.GTK IS netstandard2.0 - that is the reusable half.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <!--
      No <OutputPath> here, deliberately. The line that used to be here, bin\$(Configuration)\,
      was residue of the pre-SDK csproj (which spelled it once per Configuration) and it defeated
      the <BaseOutputPath>bin-wsl/</BaseOutputPath> that Directory.Build.props sets for a build
      driven from Unix off a /mnt mount - see the long note there for why the two sides must not
      share output. Measured: this was the only project in the tree with obj-wsl\ but no bin-wsl\,
      i.e. a WSL build kept its own intermediates and then wrote its app over the Windows one in
      bin\Debug\net10.0 - runtimeconfig.json and the copied GtkSharp/native assets included - for
      the only runnable app here. It was never a request for flat output either: OutputPath does
      not suppress the TFM subfolder (that is AppendTargetFrameworkToOutputPath), and the drop on
      disk is bin\Debug\net10.0 as usual. The SDK default is what we want.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <!-- Matches Xamarin.Forms.Platform.GTK; see the note on CS0612/CS0618 there. -->
    <NoWarn>$(NoWarn);CS0612;CS0618</NoWarn>
    <PackageId>Net4x.$(AssemblyName)</PackageId>
  </PropertyGroup>
  <!-- HAVE_OPENTK stays off permanently. OpenGLView itself works (plan M6 §9.2: it runs on
       Gtk.GLArea and is exercised by OpenGLViewCoreGalleryPage), but BasicOpenGLGallery and
       AdvancedOpenGLGallery are written against OpenTK.Graphics.OpenGL, and dropping the OpenTK
       dependency was the point of that port. -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
    <DefineConstants>DEBUG;TRACE;__GTK__</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <DefineConstants>TRACE;__GTK__</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GtkSharp" Version="3.24.24.95" />
  </ItemGroup>
  <ItemGroup>
