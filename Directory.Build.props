<Project>

  <!--
    Repo-anchored package output. The projects used $(SolutionDir)Packages/, which is
    only defined when MSBuild is driven through a .sln - so the per-project build that
    CLAUDE.md documents (dotnet build Xamarin.Forms.Platform.GTK/...csproj) packed into
    <ProjectDir>/Packages/ instead, leaving stray untracked nupkgs scattered through the
    tree. MSBuildThisFileDirectory is this file's directory, i.e. the repo root, under
    every invocation.
  -->
  <PropertyGroup>
    <XFPackageOutputPath Condition="'$(XFPackageOutputPath)' == ''">$(MSBuildThisFileDirectory)Packages/</XFPackageOutputPath>
  </PropertyGroup>

  <!--
    Windows and Unix builds of the same working tree need separate obj\ and bin\.

    A tree on a Windows drive (D:\CommonLibrary\Xamarin.Forms, reached from WSL as
    /mnt/d/CommonLibrary/Xamarin.Forms) can be built from both sides at once - Visual
    Studio on Windows, `dotnet build` in WSL - and they cannot share intermediate output:

      * project.assets.json records absolute package paths. A Windows restore writes
        C:\Users\<user>\.nuget\packages plus the VS fallback folders; those do not exist
        under WSL, so the next Linux build dies in ResolvePackageAssets with
            NuGet.Packaging.Core.PackagingException: Unable to find fallback package
            folder 'C:\Program Files (x86)\Microsoft Visual Studio\Shared\NuGetPackages'.
        (and the reverse, with /home/<user>/.nuget/packages, breaks the Windows build).
        Visual Studio's background restore rewrites obj\ on its own, so a `dotnet restore`
        in WSL is undone within seconds while the solution is open.
      * The two sides generally run different SDK versions, so each invalidates the
        other's obj\, and every build is a full rebuild.

    Redirecting the Unix side keeps both sets of artifacts intact. DefaultItemExcludes
    then has to drop the *other* side's obj\ and bin\ by hand, in both directions: the SDK
    only excludes the *current* BaseIntermediateOutputPath/BaseOutputPath from the default
    globs, so obj\<config>\<tfm>\*.AssemblyInfo.cs and ThisAssembly.GitInfo.g.cs from one
    side get compiled alongside the other side's copies (CS0579/CS0102 duplicate
    definitions). This has to be DefaultItemExcludes, not <Compile Remove="obj-wsl\**" />:
    Directory.Build.props is evaluated before Microsoft.NET.Sdk.DefaultItems.props creates
    the globs, and a Remove only affects items that already exist, so it is a no-op here.

    Scoped to trees that are actually shared, i.e. mounted under /mnt (drvfs). A native
    Linux or macOS checkout has no Windows side to collide with and keeps the conventional
    obj\/bin\ - which build.cake depends on, e.g. IOS_TEST_LIBRARY's
    ./Xamarin.Forms.Core.iOS.UITests/bin/<config>/. Force it either way with
    -p:UseOSSpecificOutputPaths=true|false.

    The XAML build tasks drop moves too, via _XFBuildTasksLocation below - otherwise the
    Unix build cannot refresh artifacts\build-tasks\ (Visual Studio holds those DLLs open:
    "Access to the path ... is denied") and silently compiles XAML with whatever Windows
    left there.
  -->
  <PropertyGroup>
    <UseOSSpecificOutputPaths Condition="'$(UseOSSpecificOutputPaths)' == '' AND '$(OS)' != 'Windows_NT' AND $(MSBuildThisFileDirectory.StartsWith('/mnt/'))">true</UseOSSpecificOutputPaths>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseOSSpecificOutputPaths)' == 'true'">
    <BaseIntermediateOutputPath>obj-wsl/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin-wsl/</BaseOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj-wsl/**;bin-wsl/**;obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Seven projects carry <Version>$(VersionPrefix).$(VersionSuffix)</Version>, injected by the
      Net4x.NuGetUtility tooling. That package is not restored here, so its NuGet.Utility.props -
      which is what would normally define these two - never gets imported, and Version evaluates
      to the bare string "." which fails restore with:
          NuGet.targets(198,5): error : '.' is not a valid version string. (Parameter 'value')
      Supplying defaults keeps the tooling's expression valid without editing those csproj files
      or requiring the package. Both are conditional, so a real restore (or an explicit
      -p:VersionPrefix=) still wins. 5.0.0 is the branch version, from GitInfo.txt.
    -->
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">5.0.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">1</VersionSuffix>
    <NoWarn>$(NoWarn);MSB3073</NoWarn>
    <!--
      Same tooling, second symptom: it also injected
          <PackageReference Include="Net4x.NuGetUtility" Version="$(NuGetUtilityVersion)" PrivateAssets="All" />
      into seven projects. The property that feeds it lives in the generated Directory.Nuget.Props,
      which nothing imports (MSBuild auto-imports Directory.Build.props/.targets, not that file), so
      the version was empty and restore failed with
          NU1015: The following PackageReference item(s) do not have a version specified.
    -->
    <NuGetUtilityVersion Condition="'$(NuGetUtilityVersion)' == ''">1.0.13</NuGetUtilityVersion>

    <!--
      Same tooling, third symptom, and the one that keeps coming back: it rewrites the GtkSharp
      reference in Xamarin.Forms.Platform.GTK and Xamarin.Forms.Maps.GTK into
          <PackageReference Include="GtkSharp" Version="$(GtkSharpVersion).$(VersionBuildSuffix)" />
      (earlier it used $(InputBoxLibraryVersion) for the same slot). GtkSharpVersion is declared in
      the generated Directory.Nuget.Props, which nothing imports - see the note above - so both
      halves were empty, the version evaluated to the bare string "." and restore died with
          NuGet.targets(198,5): error : '.' is not a valid version string.
      Pinning the two csproj files back has now been undone three times by the tooling, so the
      defaults live here instead: they make the tooling's own expression evaluate to the version
      the GTK backend is actually built against, 3.24.24.95, and survive the next rewrite.
      Both are conditional, so a real restore of Net4x.NuGetUtility still wins.
    -->
    <GtkSharpVersion Condition="'$(GtkSharpVersion)' == ''">3.24.24</GtkSharpVersion>
    <GtkSharpVersionBuildSuffix Condition="'$(GtkSharpVersionBuildSuffix)' == ''">95</GtkSharpVersionBuildSuffix>

    <!--
      Net4x.NuGetUtility is Windows-only: its targets shell out to native-windows\NuGetUtility.exe.
      Every project that uses it therefore guards all three touch points - the two
      NuGet.Utility.props/.targets imports and the PackageReference - with
      '$(OS)' == 'Windows_NT', so a Linux or macOS build neither restores nor runs it.
      The version above is still defined unconditionally: it is what those (skipped) conditions
      interpolate, and leaving it empty would reintroduce the NU1015 failure described above.
    -->

    <MinimalDirectoryNuGetProps>true</MinimalDirectoryNuGetProps>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Source builds load the XAML build tasks from artifacts\build-tasks\, published there
      by Build.Tasks' _PublishBuildTasks target.

      NOT from Xamarin.Forms.Build.Tasks\bin\: MSBuild holds a loaded task assembly open for
      the lifetime of the node, so with the solution open in Visual Studio that DLL stays
      locked and Build.Tasks can never be rebuilt ("Access to the path ... is denied").
      Loading from a separate copy puts the lock on the copy instead. This is what the old
      .nuspec\<tfm>\ drop was for; the difference is that a failed refresh now warns loudly
      instead of silently leaving a stale task behind.

      Must set _XFBuildTasksLocation (ONE underscore) - that is the property
      Xamarin.Forms.targets feeds to its <UsingTask AssemblyFile=...>. Its own default,
      $(MSBuildThisFileDirectory)<tfm>\, is correct for the packaged layout
      (build/Xamarin.Forms.targets next to build/netstandard2.0/) but wrong in-tree.

      Configuration-independent on purpose: the path is fixed, so it does not matter that
      Directory.Build.props is evaluated before the SDK defaults $(Configuration).
    -->
    <_XFBuildTasksLocation Condition="'$(_XFBuildTasksLocation)' == '' AND '$(UseOSSpecificOutputPaths)' == 'true'">$(MSBuildThisFileDirectory)artifacts/build-tasks-unix/netstandard2.0/</_XFBuildTasksLocation>
    <_XFBuildTasksLocation Condition="'$(_XFBuildTasksLocation)' == ''">$(MSBuildThisFileDirectory)artifacts\build-tasks\netstandard2.0\</_XFBuildTasksLocation>
    <__XFBuildTasksLocation>$(_XFBuildTasksLocation)</__XFBuildTasksLocation>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>portable</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <Company>Microsoft</Company>
    <Product>Xamarin.Forms</Product>
    <ProduceReferenceAssembly Condition="'$(UsingMicrosoftNETSdk)' == 'True' AND '$(Configuration)' == 'Debug'">True</ProduceReferenceAssembly>
  </PropertyGroup>
  <PropertyGroup>
    <GitDefaultBranch>main</GitDefaultBranch>
  </PropertyGroup>

  <!--
    NuGet metadata for SDK-style packing, replacing the hand-written .nuspec files.
    Each shipping project now packs itself (`dotnet pack Xamarin.Forms.Gtk.sln`); the old
    single Xamarin.Forms metapackage bundled Core + Xaml + Platform + the build tasks and
    is no longer produced from this solution.
  -->
  <PropertyGroup>
    <Authors>Microsoft</Authors>
    <Copyright>Microsoft</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/xamarin/Xamarin.Forms</PackageProjectUrl>
    <PackageIcon>xamarin_128x128.png</PackageIcon>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Files every package carries. Condition keeps them out of non-packable projects. -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)Assets\xamarin_128x128.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
  <Import Condition="'$(SampleProject)' != 'True'" Project="SourceLink.Build.props" />
  <!-- This target is replaced by GitInfo when restored. Allows Version.targets to rely on it before restore. -->
  <Target Name="GitVersion" />

  <Import Condition="'$(EnvironmentBuildPropsImported)' != 'True'" Project="Environment.Build.props" />
</Project>
